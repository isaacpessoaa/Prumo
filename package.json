{
  "name": "financas-seguras",
  "version": "1.0.0",
  "description": "Sistema de gestão financeira pessoal — Backend Frameworks (Node.js, Express, PostgreSQL)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "gen-secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\"",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  }
}
